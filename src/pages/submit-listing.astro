---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submit Your Listing - Gulf Islands Directory" noindex>
  <section class="py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <h1 class="font-['Playfair_Display'] text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Submit Your <span class="italic text-ocean-600">Listing</span>
        </h1>
        <p class="text-xl text-gray-600">
          Get your business in front of thousands of Gulf Islands visitors and locals.
        </p>
      </div>

      <!-- Pricing Summary -->
      <div class="bg-white rounded-2xl shadow-lg p-8 mb-10">
        <h2 class="font-semibold text-xl text-gray-900 mb-6 text-center">Choose Your Listing Type</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <!-- Basic -->
          <div class="border border-gray-200 rounded-xl p-6 text-center">
            <h3 class="font-semibold text-lg mb-2">Basic</h3>
            <div class="text-3xl font-bold text-gray-900 mb-1">FREE</div>
            <ul class="text-sm text-gray-600 text-left mt-4 space-y-2">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Business name & description
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Contact information
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Standard placement
              </li>
            </ul>
          </div>

          <!-- Premium -->
          <div class="border-2 border-forest-500 rounded-xl p-6 text-center relative bg-forest-50">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-forest-600 text-white text-xs font-bold px-3 py-1 rounded-full">VALUE PICK</div>
            <h3 class="font-semibold text-lg mb-2">Premium</h3>
            <div class="text-3xl font-bold text-forest-700 mb-1">$99<span class="text-sm font-normal text-gray-500">/yr</span></div>
            <ul class="text-sm text-gray-600 text-left mt-4 space-y-2">
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Everything in Basic</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><strong>Priority placement</strong> on category & island pages</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><strong>Professional SEO Description</strong> written for you</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Direct website link</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Gallery & business hours</li>
            </ul>
          </div>

          <!-- Premium Featured -->
          <div class="border-2 border-ocean-500 rounded-xl p-6 text-center relative bg-ocean-50">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-ocean-600 text-white text-xs font-bold px-3 py-1 rounded-full">MAX EXPOSURE</div>
            <h3 class="font-semibold text-lg mb-2 text-ocean-900">Premium Featured</h3>
            <div class="text-3xl font-bold text-ocean-700 mb-1">$199<span class="text-sm font-normal text-gray-500">/yr</span></div>
            <ul class="text-sm text-gray-600 text-left mt-4 space-y-2">
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Everything in Premium</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><strong>Homepage Rotation</strong> inclusion</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Enhanced detail page</li>
              <li class="flex items-start gap-2"><svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Social media features</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Success message -->
      <div id="submit-success" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center mb-8">
        <div class="text-5xl mb-4">✅</div>
        <h2 class="font-semibold text-xl text-green-800 mb-2">Listing Submitted!</h2>
        <p class="text-green-700">Thank you! We'll review your listing within 24-48 hours and send a confirmation to your email.</p>
      </div>

      <!-- Error message -->
      <div id="submit-error" class="hidden bg-red-50 border border-red-200 rounded-2xl p-4 mb-6">
        <p class="text-red-700 text-sm" id="submit-error-msg"></p>
      </div>

      <!-- Listing Form -->
      <form id="submit-form" class="bg-white rounded-2xl shadow-lg p-8">
        <h2 class="font-semibold text-xl text-gray-900 mb-6">Business Information</h2>

        <div class="space-y-6">

          <!-- Listing Type -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Listing Type *</label>
            <select id="listing_type" name="listing_type" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500">
              <option value="Basic - FREE">Basic - FREE</option>
              <option value="Premium - $99/year" selected>Premium - $99/year (Best Value)</option>
              <option value="Premium Featured - $199/year">Premium Featured - $199/year (Recommended)</option>
            </select>
          </div>

          <!-- Business Name -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Business Name *</label>
            <input id="business_name" name="business_name" type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="Your Business Name" />
          </div>

          <!-- Island -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Island *</label>
            <select id="island" name="island" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500">
              <option value="">Select an island...</option>
              <option value="Salt Spring Island">Salt Spring Island</option>
              <option value="Galiano Island">Galiano Island</option>
              <option value="Mayne Island">Mayne Island</option>
              <option value="Pender Islands">Pender Islands</option>
              <option value="Gabriola Island">Gabriola Island</option>
              <option value="Saturna Island">Saturna Island</option>
              <option value="Quadra Island">Quadra Island</option>
              <option value="Thetis Island">Thetis Island</option>
            </select>
          </div>

          <!-- Category -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Category *</label>
            <select id="category" name="category" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500">
              <option value="">Select a category...</option>
              <option value="Stay">Stay (Hotels, B&Bs, Camping)</option>
              <option value="Eat & Drink">Eat & Drink (Restaurants, Cafés)</option>
              <option value="Arts & Culture">Arts & Culture</option>
              <option value="Marine">Marine & Boating</option>
              <option value="Getting Here">Getting Here</option>
              <option value="Real Estate">Real Estate</option>
              <option value="Activities">Activities (Tours, Rentals)</option>
              <option value="Trades">Trades & Professional</option>
              <option value="Health">Health & Wellness</option>
              <option value="Farms">Farms & Agriculture</option>
              <option value="News">News & Media</option>
              <option value="Education">Education</option>
              <option value="Community">Community Organizations</option>
            </select>
          </div>

          <!-- Description -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Initial Description *</label>
            <textarea id="description" name="description" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="Tell visitors about your business..."></textarea>
            <p class="text-sm text-gray-500 mt-1">For Premium tiers, we will professionally rewrite and SEO-review this description for you.</p>
          </div>

          <!-- Phone & Business Email -->
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Phone</label>
              <input id="phone" name="phone" type="tel" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="(250) 555-0123" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Business Email</label>
              <input id="email" name="email" type="email" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="hello@yourbusiness.com" />
            </div>
          </div>

          <!-- Website & Social -->
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Website</label>
              <input id="website" name="website" type="url" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="https://yourwebsite.com" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Instagram / Facebook</label>
              <input id="social" name="social" type="text" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="@yourbusiness" />
            </div>
          </div>

          <!-- Address -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Address</label>
            <input id="address" name="address" type="text" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="123 Main Street, Ganges, BC" />
          </div>

          <!-- Hours -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Hours of Operation</label>
            <input id="hours" name="hours" type="text" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="Mon-Fri 9am-5pm, Sat 10am-4pm" />
            <p class="text-sm text-gray-500 mt-1">Included with Premium and Premium Featured tiers</p>
          </div>

          <!-- Contact Info -->
          <div class="border-t pt-6">
            <h3 class="font-semibold text-lg text-gray-900 mb-4">Your Contact Information</h3>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Your Name *</label>
                <input id="contact_name" name="contact_name" type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="John Smith" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Your Email *</label>
                <input id="contact_email" name="contact_email" type="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ocean-500 focus:border-ocean-500" placeholder="john@example.com" />
              </div>
            </div>
          </div>

          <!-- Honeypot -->
          <input type="text" name="honeypot" id="honeypot" style="display:none" tabindex="-1" autocomplete="off" />

          <!-- Submit -->
          <div class="pt-4">
            <button id="submit-btn" type="submit" class="w-full bg-ocean-600 hover:bg-ocean-700 text-white px-8 py-4 rounded-lg font-semibold transition text-lg">
              Submit Listing →
            </button>
            <p class="text-sm text-gray-500 text-center mt-4">
              Listings are reviewed within 24-48 hours. We'll email you a confirmation.
            </p>
          </div>

        </div>
      </form>

      <!-- FAQ -->
      <div class="mt-12">
        <h2 class="font-semibold text-xl text-gray-900 mb-6 text-center">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <h3 class="font-semibold text-gray-900 mb-2">How long until my listing goes live?</h3>
            <p class="text-gray-600">Listings are reviewed within 24-48 hours. You'll receive an email confirmation once your listing is approved.</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <h3 class="font-semibold text-gray-900 mb-2">Can I update my listing later?</h3>
            <p class="text-gray-600">Yes! You can request changes to your listing at any time by emailing us at support@natinternet.com.</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <h3 class="font-semibold text-gray-900 mb-2">What's included in the SEO Content service?</h3>
            <p class="text-gray-600">Our team will write a professional business description, optimized for Gulf Islands search terms, ensuring your business stands out to both customers and search engines.</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <h3 class="font-semibold text-gray-900 mb-2">Can I upgrade from Basic to Premium later?</h3>
            <p class="text-gray-600">Absolutely! You can upgrade your listing at any time via the NEIC customer dashboard.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const WORKER_ENDPOINT = 'https://gulfislands-submit-processor.jpjanze.workers.dev/api/submit';

    const form = document.getElementById('submit-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const successEl = document.getElementById('submit-success') as HTMLElement;
    const errorEl = document.getElementById('submit-error') as HTMLElement;
    const errorMsg = document.getElementById('submit-error-msg') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      btn.disabled = true;
      btn.textContent = 'Submitting…';
      errorEl.classList.add('hidden');

      const payload = {
        listing_type:  (document.getElementById('listing_type') as HTMLSelectElement).value,
        business_name: (document.getElementById('business_name') as HTMLInputElement).value.trim(),
        island:        (document.getElementById('island') as HTMLSelectElement).value,
        category:      (document.getElementById('category') as HTMLSelectElement).value,
        description:   (document.getElementById('description') as HTMLTextAreaElement).value.trim(),
        phone:         (document.getElementById('phone') as HTMLInputElement).value.trim(),
        email:         (document.getElementById('email') as HTMLInputElement).value.trim(),
        website:       (document.getElementById('website') as HTMLInputElement).value.trim(),
        social:        (document.getElementById('social') as HTMLInputElement).value.trim(),
        address:       (document.getElementById('address') as HTMLInputElement).value.trim(),
        hours:         (document.getElementById('hours') as HTMLInputElement).value.trim(),
        contact_name:  (document.getElementById('contact_name') as HTMLInputElement).value.trim(),
        contact_email: (document.getElementById('contact_email') as HTMLInputElement).value.trim(),
        honeypot:      (document.getElementById('honeypot') as HTMLInputElement).value,
      };

      try {
        const res = await fetch(WORKER_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json() as { success: boolean; message: string };

        if (data.success) {
          form.classList.add('hidden');
          successEl.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          errorMsg.textContent = data.message || 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Submit Listing →';
        }
      } catch (err) {
        errorMsg.textContent = 'Network error. Please check your connection and try again.';
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Submit Listing →';
      }
    });
  </script>
</Layout>
