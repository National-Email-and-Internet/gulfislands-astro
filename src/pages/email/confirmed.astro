---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Email Confirmed — Gulf Islands" description="Your island email address is being set up.">
  <section class="py-24 bg-ocean-900 text-white min-h-[70vh] flex items-center">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="mb-8" id="status-icon">
        <!-- Pulsing spinner while loading -->
        <div id="loading-spinner" class="flex justify-center gap-2">
          <span class="w-3 h-3 bg-ocean-400 rounded-full" style="animation: pulse 1.4s ease-in-out infinite"></span>
          <span class="w-3 h-3 bg-ocean-400 rounded-full" style="animation: pulse 1.4s ease-in-out 0.2s infinite"></span>
          <span class="w-3 h-3 bg-ocean-400 rounded-full" style="animation: pulse 1.4s ease-in-out 0.4s infinite"></span>
        </div>
        <!-- Checkmark when ready (hidden initially) -->
        <svg id="checkmark-icon" class="w-20 h-20 mx-auto text-green-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>

      <style>
        @keyframes pulse {
          0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
          40% { opacity: 1; transform: scale(1); }
        }
      </style>

      <h1 class="font-['Playfair_Display'] text-3xl md:text-4xl font-bold mb-4">
        Welcome to Your <span class="italic text-ocean-200">Island</span> Email
      </h1>

      <p class="text-lg text-gray-300 mb-8" id="status-message">
        Setting up your mailbox...
      </p>

      <!-- Credentials (populated by JS) -->
      <div id="credentials-box" class="hidden bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20 mb-8">
        <h2 class="font-semibold text-lg mb-4">Your Login Details</h2>
        <div class="space-y-3 text-left">
          <div class="flex justify-between items-center bg-white/5 rounded-lg p-3">
            <span class="text-white/60">Email</span>
            <span id="cred-email" class="font-mono text-white"></span>
          </div>
          <div class="flex justify-between items-center bg-white/5 rounded-lg p-3">
            <span class="text-white/60">Password</span>
            <div class="flex items-center gap-2">
              <span id="cred-password" class="font-mono text-white"></span>
              <button id="copy-password-btn" class="text-ocean-300 hover:text-ocean-200 text-sm" title="Copy password">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
        <p class="text-xs text-white/40 mt-4">Save this password — you'll need it to log in.</p>
      </div>

      <!-- Backup email -->
      <div id="backup-email-box" class="hidden bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20 mb-8">
        <h2 class="font-semibold text-lg mb-4">Send Instructions to Your Email</h2>
        <p class="text-sm text-gray-300 mb-4">Enter an email address to receive your login instructions.</p>
        <div class="flex gap-3">
          <input 
            type="email" 
            id="backup-email-input" 
            placeholder="you@example.com"
            class="flex-1 bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:border-ocean-400"
          />
          <button 
            id="send-backup-btn"
            class="bg-ocean-500 hover:bg-ocean-400 text-white px-6 py-3 rounded-lg font-semibold transition disabled:opacity-50"
          >
            Send
          </button>
        </div>
        <p id="backup-status" class="text-sm text-green-400 mt-3 hidden">✓ Instructions sent!</p>
      </div>

      <div class="space-y-4">
        <a href="https://webmail.gulfislands.com" class="inline-block bg-ocean-500 hover:bg-ocean-400 text-white px-8 py-3 rounded-full font-semibold transition shadow-lg">
          Go to Webmail
        </a>
        <p class="text-sm text-white/40">
          Questions? Email <a href="mailto:support@natinternet.com" class="text-ocean-300 hover:text-ocean-200">support@natinternet.com</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const sessionId = new URLSearchParams(window.location.search).get('session_id');
  const credentialsBox = document.getElementById('credentials-box')!;
  const backupBox = document.getElementById('backup-email-box')!;
  const statusMessage = document.getElementById('status-message')!
  const copyBtn = document.getElementById('copy-password-btn')!;
  const sendBtn = document.getElementById('send-backup-btn') as HTMLButtonElement;
  const backupInput = document.getElementById('backup-email-input') as HTMLInputElement;
  const backupStatus = document.getElementById('backup-status')!;

  if (sessionId) {
    pollForCredentials(sessionId);
  } else {
    statusMessage.textContent = 'Your mailbox is being created. The welcome email with login details will arrive shortly.';
  }

  async function pollForCredentials(sid: string) {
    const maxAttempts = 30;
    for (let i = 0; i < maxAttempts; i++) {
      try {
        const res = await fetch(`https://ops.natinternet.com/api/email/session?session_id=${encodeURIComponent(sid)}`);
        const data = await res.json();

        if (data.success) {
          showCredentials(data.email, data.password);
          return;
        }

        if (res.status === 202) {
          // Still pending — retry
          await new Promise(r => setTimeout(r, 2000));
          continue;
        }

        // Error — stop polling
        statusMessage.textContent = 'Your mailbox is being created. The welcome email with login details will arrive shortly.';
        return;
      } catch {
        await new Promise(r => setTimeout(r, 2000));
      }
    }
    statusMessage.textContent = 'Your mailbox is being created. The welcome email with login details will arrive shortly.';
  }

  function showCredentials(email: string, password: string) {
    statusMessage.textContent = 'Your mailbox is ready!';
    document.getElementById('loading-spinner')!.classList.add('hidden');
    document.getElementById('checkmark-icon')!.classList.remove('hidden');
    
    document.getElementById('cred-email')!.textContent = email;
    document.getElementById('cred-password')!.textContent = password;
    credentialsBox.classList.remove('hidden');
    backupBox.classList.remove('hidden');
  }

  // Copy password
  copyBtn.addEventListener('click', () => {
    const pw = document.getElementById('cred-password')!.textContent;
    if (pw) {
      navigator.clipboard.writeText(pw).then(() => {
        copyBtn.innerHTML = '<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
        setTimeout(() => {
          copyBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
        }, 2000);
      });
    }
  });

  // Send backup email
  sendBtn.addEventListener('click', async () => {
    const email = backupInput.value.trim();
    if (!email || !email.includes('@')) return;
    
    sendBtn.textContent = 'Sending...';
    sendBtn.disabled = true;

    try {
      const res = await fetch('https://ops.natinternet.com/api/email/send-welcome', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          to: email,
          session_id: sessionId,
        }),
      });

      if (res.ok) {
        backupStatus.classList.remove('hidden');
      } else {
        alert('Failed to send. Try again or contact support.');
      }
    } catch {
      alert('Failed to send. Try again or contact support.');
    } finally {
      sendBtn.textContent = 'Send';
      sendBtn.disabled = false;
    }
  });
</script>